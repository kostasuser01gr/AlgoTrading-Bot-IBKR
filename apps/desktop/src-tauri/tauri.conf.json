{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adaptive Multi-Model Trading Operator",
  "version": "0.1.0",
  "identifier": "com.adaptive.operator",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "beforeBuildCommand": "pnpm --dir .. build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Adaptive Multi-Model Trading Operator",
        "width": 1600,
        "height": 980,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
